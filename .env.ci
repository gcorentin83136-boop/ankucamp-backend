# ============================
# FICHIER POUR LA CI UNIQUEMENT
# ============================
NODE_ENV=test
PORT=3001
JWT_SECRET=test-secret-at-least-16-chars-long
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ankucamp_ci
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/ankucamp_ci_test

# Cloudinary (valeurs factices)
CLOUDINARY_CLOUD_NAME=test_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=test_secret

# Google OAuth (valeurs factices)
GOOGLE_CLIENT_ID=test_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Stripe (valeurs qui respectent le startsWith)
STRIPE_SECRET_KEY=sk_test_1234567890abcdef
STRIPE_WEBHOOK_SECRET=whsec_1234567890abcdef

# Marketplace
PLATFORM_FEE_PERCENT=2.5

# Firebase (chaîne > 100 caractères)
FIREBASE_SERVICE_ACCOUNT_

# Brevo (commence par xkeysib-)
BREVO_API_KEY=xkeysib-1234567890abcdef
EMAIL_FROM=noreply@ankucamp.com
EMAIL_FROM_NAME=ANKUCAMP

# Sentry (optionnel, on laisse vide)
SENTRY_DSN=
SENTRY_ENVIRONMENT=test

# Backup
BACKUP_DIR=
BACKUP_RETENTION_DAYS=30