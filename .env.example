# ============================
# CORE
# ============================
NODE_ENV=development
PORT=3001
JWT_SECRET=change-me-at-least-16-chars

# ============================
# DATABASE (PostgreSQL)
# ============================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ankucamp
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/ankucamp_test

# ============================
# CLOUDINARY (upload images)
# ============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================
# GOOGLE OAUTH
# ============================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ============================
# STRIPE (paiements)
# ============================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ============================
# MARKETPLACE
# ============================
PLATFORM_FEE_PERCENT=2.5

# ============================
# FIREBASE CLOUD MESSAGING (push)
# ============================
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ============================
# BREVO (emails transactionnels)
# ============================
BREVO_API_KEY=xkeysib-xxx
EMAIL_FROM=noreply@ankucamp.com
EMAIL_FROM_NAME=ANKUCAMP

# ============================
# SENTRY (monitoring — optionnel)
# ============================
# Si vide → Sentry désactivé (aucune erreur envoyée)
# Crée un projet sur https://sentry.io/signup/ pour obtenir un DSN
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============================
# BACKUP DB (optionnel)
# ============================
# Si vide → ./backups/ par défaut
BACKUP_DIR=
# 30 jours par défaut
BACKUP_RETENTION_DAYS=30